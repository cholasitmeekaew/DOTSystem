# ============================================================
# DOTSystem — environment variables
# ============================================================
# ✅ Bolt / local dev: ใช้ค่า default นี้ได้เลย (JSON mode, ไม่ต้อง Supabase)
# 🚀 Production: ใส่ Supabase URL + Anon Key แล้วตั้ง VITE_USE_MOCK=false
# ============================================================

# ---- Supabase URL + Anon Key ----
# หาได้ที่ https://supabase.com/dashboard → Project Settings → API
# ปล่อยว่างไว้ได้ถ้าใช้ JSON mode
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Mode switch ----
# ✅ true  = JSON/localStorage mode (DEFAULT — ใช้ได้ทันทีใน Bolt)
# 🔗 false = Supabase mode (ต้องตั้ง URL + ANON_KEY ด้านบนให้ครบ)
VITE_USE_MOCK=true

# ---- Optional: Discord webhook (ยังไม่ได้ใช้ — เผื่ออนาคต) ----
# VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
