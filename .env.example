# ============================================================
# DOTSystem — environment variables
# ============================================================
# ค่าเริ่มต้น: ใช้ JSON mode (localStorage) — ไม่ต้องตั้ง Supabase
# เปิดใช้ Supabase mode: ใส่ URL + Anon Key แล้วตั้ง VITE_USE_MOCK=false
# ✅ Bolt / local dev: ใช้ค่า default (JSON mode) ได้เลย
# ============================================================

# ---- Supabase mode (ตั้งทั้ง 2 ค่า + USE_MOCK=false ถึงจะ active) ----
# หาได้ที่ https://supabase.com/dashboard → Project Settings → API
# ⚠️ ห้าม commit key จริงลง Git — ใช้ไฟล์ .env (อยู่ใน .gitignore) แทน
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Mode switch ----
# true  = JSON/localStorage mode (default — ไม่ต้อง Supabase)
# false = Supabase mode (ต้องตั้ง URL + ANON_KEY ด้านบน)
VITE_USE_MOCK=true

# ---- Server-side scripts (create-user, run-migrations, check-admin) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ---- Vite ----
BASE_PATH=/
PORT=3000

# ---- Optional: Discord webhook (ยังไม่ได้ใช้ — เผื่ออนาคต) ----
# ใช้ในอนาคต — ตอนนี้ยังไม่ได้ wire เข้า component
# VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
